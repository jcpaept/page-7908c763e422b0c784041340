uted);font-size:14px}\n.client .link{font-size:13px;color:var(--amber)}\n\n/* FAQ */\n.faq-group{margin-bottom:40px}\n.faq-group h3{color:var(--amber);font-size:18px;margin-bottom:20px;padding-bottom:10px;border-bottom:1px solid var(--line)}\n.faq-item{background:rgba(255,255,255,0.02);border-radius:20px;padding:20px 24px;margin-bottom:16px;box-shadow:0 8px 22px rgba(0,0,0,0.18)}\n.faq-item details summary{cursor:pointer;font-weight:600;font-size:15px;list-style:none}\n.faq-item details summary::-webkit-details-marker{display:none}\n.faq-item details summary:before{content:\"+\";color:var(--amber);margin-right:10px}\n.faq-item details[open] summary:before{content:\"–\"}\n.faq-item p{margin:12px 0 0;color:var(--muted);font-size:14px}\n\n/* Footer */\nfooter{border-top:1px solid var(--line);padding:32px 56px;color:var(--muted);font-size:13px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}\n\n@media (max-width:880px){\n  .hero{grid-template-columns:1fr}\n  .hero-right{border-left:0;border-top:1px solid var(--line)}\n  .hero-left,section,.hero-right{padding:40px 24px}\n  .plans,.steps,.clients-grid{grid-template-columns:1fr}\n  .plan:nth-child(2),.plan:nth-child(3){transform:none}\n}\n</style><main>\n\n<header class=\"hero\">\n  <div class=\"hero-left\">\n    <div>\n      <div class=\"brand-tag\">紅海 / Red Sea Network</div>\n      <h1>紅海 · 深海级稳定<br><span>琥珀级延迟</span></h1>\n      <p class=\"hero-lead\">专线穿透、流媒体解锁、游戏加速。按需订阅，三档可选，不卖噱头。</p>\n      <nav class=\"hero-nav\">\n        <a href=\"#plans\">订阅套餐</a>\n        <a href=\"#usage\">使用方式</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </div>\n\n  <aside class=\"hero-right\">\n    <div class=\"info-card\">\n      <h3>网络概览</h3>\n      <div class=\"info-list\">\n        <div class=\"info-row\"><b>接入方式</b><span>专线 / IPLC</span></div>\n        <div class=\"info-row\"><b>设备并发</b><span>3 — 20 台</span></div>\n        <div class=\"info-row\"><b>流媒体</b><span>原生解锁</span></div>\n        <div class=\"info-row\"><b>起步价格</b><span>¥15/月</span></div>\n        <div class=\"info-row\"><b>工单响应</b><span>7×24</span></div>\n      </div>\n    </div>\n    <div class=\"info-card\">\n      <h3>适合谁</h3>\n      <p>个人影音用户、跨境游戏玩家、远程办公团队。从单人到二十人小组，都有对应档位。</p>\n    </div>\n  </aside>\n</header>\n\n<section id=\"plans\">\n  <div class=\"section-head\">\n    <h2>订阅套餐</h2>\n    <em>阶梯递进</em>\n  </div>\n\n  <div class=\"plans\">\n    <article class=\"plan\">\n      <h3>基础版</h3>\n      <div class=\"price\">¥15/月</div>\n      <div class=\"annual\">按年付仅需 ¥150/年</div>\n      <ul>\n        <li>每月 100GB 高速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n    </article>\n\n    <article class=\"plan\">\n      <span class=\"badge\">推荐</span>\n      <h3>旗舰版</h3>\n      <div class=\"price\">¥35/月</div>\n      <div class=\"annual\">按年付仅需 ¥350/年</div>\n      <ul>\n        <li>每月 300GB 高速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7×24 优先工单支持</li>\n      </ul>\n    </article>\n\n    <article class=\"plan\">\n      <h3>团队版</h3>\n      <div class=\"price\">¥85/月</div>\n      <div class=\"annual\">按年付仅需 ¥850/年</div>\n      <ul>\n        <li>每月 1000GB 高速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n    </article>\n  </div>\n</section>\n\n<section id=\"usage\">\n  <div class=\"section-head\">\n    <h2>使用方式</h2>\n    <em>三步接入</em>\n  </div>\n\n  <div class=\"steps\">\n    <article class=\"step\">\n      <div class=\"num\">01</div>\n      <h3>选择套餐</h3>\n      <p>按设备数和流量需求选档。年付更划算，可随时升级。</p>\n    </article>\n    <article class=\"step\">\n      <div class=\"num\">02</div>\n      <h3>下载客户端</h3>\n      <p>Windows、macOS、Android、iOS 均支持。导入订阅链接即可。</p>\n    </article>\n    <article class=\"step\">\n      <div class=\"num\">03</div>\n      <h3>选择节点</h3>\n      <p>按用途切换：影音选解锁线路，游戏选 IPLC 低延迟线路。</p>\n    </article>\n  </div>\n</section>\n\n<section id=\"clients\">\n  <div class=\"section-head\">\n    <h2>客户端</h2>\n    <em>按平台选择</em>\n  </div>\n\n  <div class=\"clients-grid\">\n    <article class=\"client\">\n      <h3>桌面端</h3>\n      <p>Windows 10 及以上、macOS 11 及以上。支持系统代理与分流规则。</p>\n      <div class=\"link\">下载地址以订阅页面为准</div>\n    </article>\n    <article class=\"client\">\n      <h3>移动端</h3>\n      <p>Android 9 及以上、iOS 15 及以上。支持按应用分流与暗色主题。</p>\n      <div class=\"link\">下载地址以订阅页面为准</div>\n    </article>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"section-head\">\n    <h2>常见问题</h2>\n    <em>按主题分组</em>\n  </div>\n\n  <div class=\"faq-group\">\n    <h3>订阅与计费</h3>\n    <div class=\"faq-item\"><details>\n      <summary>套餐之间能随时升级吗？</summary>\n      <p>可以。补差价后即时生效，剩余流量按比例结转。</p>\n    </details></div>\n    <div class=\"faq-item\"><details>\n      <summary>支持哪些支付方式？</summary>\n      <p>支持支付宝、微信支付与部分加密货币。年付享额外优惠。</p>\n    </details></div>\n  </div>\n\n  <div class=\"faq-group\">\n    <h3>网络与节点</h3>\n    <div class=\"faq-item\"><details>\n      <summary>IPLC 专线和普通线路有什么区别？</summary>\n      <p>IPLC 为点对点专线，延迟更低、抖动更小，适合游戏与实时通信。普通线路覆盖更广，适合日常浏览。</p>\n    </details></div>\n    <div class=\"faq-item\"><details>\n      <summary>流媒体解锁覆盖哪些地区？</summary>\n      <p>旗舰版及以上支持主流地区的原生 IP 解锁。具体可用清单以订阅页实时状态为准。</p>\n    </details></div>\n  </div>\n\n  <div class=\"faq-group\">\n    <h3>设备与兼容</h3>\n    <div class=\"faq-item\"><details>\n      <summary>一台账号能在多少设备上使用？</summary>\n      <p>基础版 3 台、旗舰版 5 台、团队版 20 台。超出限制会提示下线最早会话。</p>\n    </details></div>\n    <div class=\"faq-item\"><details>\n      <summary>支持路由器部署吗？</summary>\n      <p>团队版支持企业定制路由方案。个人版建议使用客户端分流，不保证特定固件兼容。</p>\n    </details></div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div>紅海 — 深海级稳定专线服务</div>\n  <div>本页内容为产品介绍，不构成交易要约。</div>\n</footer>",
